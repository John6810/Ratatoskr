  "env": {
    "RATATOSKR_PROJECT": "true"
  },

  "attribution": {
    "commits": false,
    "pullRequests": false
  },

  "includeCoAuthoredBy": false,

  "cleanupPeriodDays": 30,

  "spinnerTipsEnabled": true
}
