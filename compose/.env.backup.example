# ratatoskr — backup profile environment.
#
# Copy to `.env.backup` and fill in. Sensitive values (passwords) are NOT
# in this file — they live under `compose/secrets/` and are mounted into
# the backup container as files via the Docker secrets mechanism.
# See README.md "Backup & restore" for the setup procedure.

# --- Restic repository (required) ---------------------------------------
# Backblaze B2 example — recommended default for new operators.
# Other supported backends:
#   s3:s3.amazonaws.com/bucket/path                 AWS S3
#   s3:storage.googleapis.com/bucket/path           GCS via S3 compat layer
#   s3:<minio-endpoint>/bucket/path                 MinIO (self-hosted)
#   s3:<r2-endpoint>/bucket/path                    Cloudflare R2 (zero egress)
#   sftp:user@host:/path                            SFTP
#   /srv/backups                                    local path inside container
#                                                   (mount a volume there)
RESTIC_REPOSITORY=b2:CHANGEME-bucket-name:/ratatoskr

# Backblaze B2 credentials. Only required when RESTIC_REPOSITORY uses b2:.
# Generate an Application Key with read+write scoped to the bucket only —
# never the master key.
B2_ACCOUNT_ID=CHANGEME
B2_ACCOUNT_KEY=CHANGEME

# --- MariaDB backup user ------------------------------------------------
# Created via SQL on the running MariaDB instance — see README "Backup &
# restore" for the GRANT statement. The password lives in
# compose/secrets/mariadb_backup_password, not here.
MARIADB_USER=backup

# --- Snapshot tagging ---------------------------------------------------
# BACKUP_HOSTNAME defaults to $(hostname) inside the container. Override
# when running multiple ratatoskr deployments against the same restic
# repository — otherwise `restore latest` may pull the wrong instance's
# snapshot. Example:
#   BACKUP_HOSTNAME=tracker-prod-eu

# Tag attached to every snapshot taken by ratatoskr. Change only if you
# operate multiple distinct backup pipelines in the same repo.
BACKUP_TAG=ratatoskr-mariadb

# --- Retention ----------------------------------------------------------
# Daily snapshots kept; older are pruned on each backup run.
BACKUP_RETENTION_DAILY=30

# Set false to skip restic forget+prune after each backup. Useful when you
# run prune from a separate weekly cron to avoid repo lock contention with
# the daily backup. Default is true (single-cron deployments).
BACKUP_PRUNE=true

# --- Performance tuning -------------------------------------------------
# mariadb-backup --parallel: concurrency for InnoDB file copy. 4 is sane
# on most VPS-class hardware; increase on >8-core hosts with NVMe.
MARIABACKUP_PARALLEL=4

# zstd compression level (1..19). 3 is the upstream default and the right
# balance for streaming — higher levels stop being faster than the network
# pipe on most setups.
ZSTD_LEVEL=3
