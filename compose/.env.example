# ratatoskr — Compose environment.
#
# Copy to .env, replace every CHANGEME, then `docker compose up -d --build`.
# .env is read both for compose variable substitution and for env_file
# injection into the unit3d / migrate / scheduler / queue containers.

# -----------------------------------------------------------------------------
# Compose-only knobs (not consumed by UNIT3D)
# -----------------------------------------------------------------------------

# Override to build a different UNIT3D tag (e.g. a release candidate).
UNIT3D_VERSION=v9.2.0

# Host port the unit3d container binds to (loopback only, never 0.0.0.0).
UNIT3D_PORT=8080

# MariaDB root password — used by the mariadb container only, not by UNIT3D.
# Generate with: openssl rand -base64 24
MARIADB_ROOT_PASSWORD=CHANGEME

# -----------------------------------------------------------------------------
# Laravel / UNIT3D core
# -----------------------------------------------------------------------------

APP_NAME="Ratatoskr UNIT3D"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Generate ONCE with:
#   printf "base64:%s\n" "$(openssl rand -base64 32)"
# Never rotate — rotating breaks all encrypted columns and signed URLs.
APP_KEY=CHANGEME

LOG_CHANNEL=stack
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Database (MariaDB)
# -----------------------------------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=unit3d
DB_USERNAME=unit3d
# Generate with: openssl rand -base64 24
DB_PASSWORD=CHANGEME

# -----------------------------------------------------------------------------
# Redis (cache + sessions + queues + broadcast)
# -----------------------------------------------------------------------------

REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=CHANGEME

# Var names match upstream UNIT3D v9.2.0 .env.example (Laravel 11 conventions:
# CACHE_STORE not CACHE_DRIVER, BROADCAST_CONNECTION not BROADCAST_DRIVER).
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis

# Frontend Echo / Reverb websocket address. UNIT3D v9.2.0 reads this at boot
# (config/secure-headers.php builds the CSP from it) — leaving it unset
# crashes `php artisan migrate` with parse_url(null). Set it even if you
# don't use websockets; point it to your real Reverb endpoint when you do.
VITE_ECHO_ADDRESS=http://localhost:8443

# -----------------------------------------------------------------------------
# MeiliSearch
# -----------------------------------------------------------------------------

MEILISEARCH_HOST=http://meilisearch:7700
# Master key. Must be at least 16 bytes. Generate with:
#   openssl rand -base64 24
MEILISEARCH_KEY=CHANGEME
MEILI_ENV=production

# -----------------------------------------------------------------------------
# First-boot owner — seeded once by unit3d-migrate (UserSeeder).
# After first boot, change the password from the UI; this var is no longer
# read for password updates, only for the initial create.
# -----------------------------------------------------------------------------

DEFAULT_OWNER_NAME=admin
DEFAULT_OWNER_EMAIL=admin@example.local
DEFAULT_OWNER_PASSWORD=CHANGEME

# -----------------------------------------------------------------------------
# Mail (compose default = log to stderr; switch to smtp/mailgun/ses in prod)
# -----------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.local"
MAIL_FROM_NAME="${APP_NAME}"
