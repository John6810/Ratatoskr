# ratatoskr — TEST-ONLY deterministic fixtures for the docker-build-local skill.
#
# These values exist solely so the smoke test is reproducible. They are NOT
# secrets — every value here is committed to the repo and clearly test-shaped.
# Never copy these into a real .env. Never reuse them outside this smoke test.

UNIT3D_VERSION=v9.2.0
UNIT3D_PORT=0

MARIADB_ROOT_PASSWORD=test_root_password_not_a_secret

APP_NAME="Ratatoskr UNIT3D (smoke test)"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
# 32 bytes of zeros, base64 — deterministic and obviously fake.
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=unit3d_test
DB_USERNAME=unit3d_test
DB_PASSWORD=test_db_password_not_a_secret

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=test_redis_password_not_a_secret

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=redis

# Required at boot — see compose/.env.example for the upstream rationale.
VITE_ECHO_ADDRESS=http://localhost:8443

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=test_meilisearch_master_key_not_a_secret
MEILI_ENV=development

DEFAULT_OWNER_NAME=smoketest
DEFAULT_OWNER_EMAIL=smoketest@example.local
DEFAULT_OWNER_PASSWORD=test_owner_password_not_a_secret

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.local"
MAIL_FROM_NAME="${APP_NAME}"
