# FrankenPHP Caddyfile — UNIT3D worker mode.
#
# SERVER_NAME is injected at runtime (default :80). Behind a reverse proxy
# (Traefik, Ingress) keep the default and terminate TLS upstream. As an
# edge container, set SERVER_NAME to a real hostname to enable automatic
# Let's Encrypt TLS via Caddy.

{
	# FrankenPHP global config — worker mode is what makes this image worth using.
	# The worker file is Octane's stub (vendor/laravel/octane/src/Commands/stubs/
	# frankenphp-worker.php), copied to public/ at build time. Stock public/index.php
	# does not call frankenphp_handle_request() and aborts the worker loop.
	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:4}
		worker {
			file ./public/frankenphp-worker.php
			num {$FRANKENPHP_NUM_WORKERS:2}
		}
	}

	# Quieter admin endpoint — disable in containers (Caddy admin API is
	# not needed at runtime and the listener leaks the worker count).
	admin off

	# JSON access logs go to stdout via the per-site `log` directive below.
}

{$SERVER_NAME} {
	log {
		output stdout
		# UNIT3D embeds passkeys in paths, not only query parameters. Header
		# values (Referer, cookies, authorization) can contain credentials too.
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers delete
			}
		}
	}

	root * /app/public

	# Announce responses must retain their exact bencoded representation.
	@compressible not path /announce /announce/*
	encode @compressible zstd br gzip

	header {
		-Server
		-X-Powered-By
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Long cache for hashed Vite assets.
	@static {
		path /build/* /favicon.ico /robots.txt
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	route {
		# Never expose dotfiles or dispatch arbitrary PHP files placed in the
		# public tree. Requests enter Laravel only through the worker below.
		@private path_regexp private (?i)(^|/)\.[^/]+
		respond @private 404
		@scripts path_regexp scripts (?i)\.(php[0-9]?|phtml|phar)(/|$)
		respond @scripts 404
		php_server {
			index frankenphp-worker.php
			try_files {path} frankenphp-worker.php
			resolve_root_symlink
		}
	}
}
