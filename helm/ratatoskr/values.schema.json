{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ratatoskr Helm chart values",
  "description": "Schema for ratatoskr v0.5.0-alpha.1 — production deployment stack for UNIT3D Community Edition.",
  "type": "object",
  "additionalProperties": true,
  "required": ["unit3d", "mariadb", "redis", "meilisearch"],
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository"]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string" }
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string" }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]
        },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" }
      },
      "required": ["enabled"]
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "runAsNonRoot": { "type": "boolean" },
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "fsGroup": { "type": "integer", "minimum": 0 }
      }
    },
    "hpaBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "metrics": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": true }
        },
        "behavior": { "type": "object", "additionalProperties": true }
      }
    },
    "pdbBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] }
      },
      "oneOf": [
        {
          "description": "minAvailable set, maxUnavailable absent.",
          "required": ["minAvailable"],
          "not": { "required": ["maxUnavailable"] }
        },
        {
          "description": "maxUnavailable set, minAvailable absent.",
          "required": ["maxUnavailable"],
          "not": { "required": ["minAvailable"] }
        }
      ]
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "imageRegistry": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["name"]
          }
        },
        "storageClass": { "type": "string" }
      }
    },
    "unit3d": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "image": { "$ref": "#/definitions/image" },
        "appKey": { "type": "string" },
        "bootstrapAppKey": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "existingSecretAppKeyKey": { "type": "string", "minLength": 1 },
        "appUrl": { "type": "string", "format": "uri" },
        "appEnv": {
          "type": "string",
          "enum": ["production", "local", "testing", "staging"]
        },
        "appDebug": { "type": "boolean" },
        "logLevel": {
          "type": "string",
          "enum": ["debug", "info", "notice", "warning", "error", "critical", "alert", "emergency"]
        },
        "trustedProxies": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
        "containerSecurityContext": { "type": "object", "additionalProperties": true },
        "probes": { "type": "object", "additionalProperties": true },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "name": { "type": "string", "minLength": 1 },
            "user": { "type": "string", "minLength": 1 },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 }
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 }
          }
        },
        "meilisearch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "existingSecret": { "type": "string" },
            "existingSecretMasterKeyKey": { "type": "string", "minLength": 1 }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "torrentFiles": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "driver": { "type": "string", "enum": ["local", "s3"] }
              }
            },
            "subtitleFiles": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "driver": { "type": "string", "enum": ["local", "s3"] }
              }
            },
            "attachmentFiles": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "driver": { "type": "string", "enum": ["local", "s3"] }
              }
            },
            "s3": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": { "type": "string" },
                "secret": { "type": "string" },
                "region": { "type": "string" },
                "bucket": { "type": "string" },
                "endpoint": { "type": "string" },
                "usePathStyleEndpoint": { "type": "boolean" },
                "existingSecret": { "type": "string" },
                "existingSecretKeyKey": { "type": "string", "minLength": 1 },
                "existingSecretSecretKeyKey": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "description": "Inline APP_KEY: appKey set, no bootstrap, no existingSecret.",
          "properties": {
            "appKey": { "type": "string", "minLength": 1 },
            "bootstrapAppKey": { "const": false },
            "existingSecret": { "type": "string", "maxLength": 0 }
          },
          "required": ["appKey"]
        },
        {
          "description": "Bootstrap APP_KEY: bootstrapAppKey=true, no inline appKey, no existingSecret.",
          "properties": {
            "appKey": { "type": "string", "maxLength": 0 },
            "bootstrapAppKey": { "const": true },
            "existingSecret": { "type": "string", "maxLength": 0 }
          },
          "required": ["bootstrapAppKey"]
        },
        {
          "description": "External APP_KEY: existingSecret set, no inline appKey, no bootstrap.",
          "properties": {
            "appKey": { "type": "string", "maxLength": 0 },
            "bootstrapAppKey": { "const": false },
            "existingSecret": { "type": "string", "minLength": 1 }
          },
          "required": ["existingSecret"]
        }
      ]
    },
    "queue": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 }
      }
    },
    "mariadb": {
      "type": "object",
      "additionalProperties": true,
      "required": ["auth"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database", "username"],
          "properties": {
            "rootPassword": { "type": "string" },
            "database": { "type": "string", "minLength": 1 },
            "username": { "type": "string", "minLength": 1 },
            "password": { "type": "string" },
            "backupPassword": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretRootPasswordKey": { "type": "string", "minLength": 1 },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 },
            "existingSecretBackupPasswordKey": { "type": "string", "minLength": 1 }
          },
          "oneOf": [
            {
              "description": "Inline credentials path: rootPassword + password set, existingSecret empty.",
              "properties": {
                "rootPassword": { "type": "string", "minLength": 1 },
                "password": { "type": "string", "minLength": 1 },
                "existingSecret": { "type": "string", "maxLength": 0 }
              },
              "required": ["rootPassword", "password"]
            },
            {
              "description": "External Secret path: existingSecret set, inline passwords empty.",
              "properties": {
                "rootPassword": { "type": "string", "maxLength": 0 },
                "password": { "type": "string", "maxLength": 0 },
                "existingSecret": { "type": "string", "minLength": 1 }
              },
              "required": ["existingSecret"]
            }
          ]
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
        "containerSecurityContext": { "type": "object", "additionalProperties": true },
        "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["auth"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "password": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretPasswordKey": { "type": "string", "minLength": 1 }
          },
          "oneOf": [
            {
              "description": "Inline credentials path: password set, existingSecret empty.",
              "properties": {
                "password": { "type": "string", "minLength": 1 },
                "existingSecret": { "type": "string", "maxLength": 0 }
              },
              "required": ["password"]
            },
            {
              "description": "External Secret path: existingSecret set, inline password empty.",
              "properties": {
                "password": { "type": "string", "maxLength": 0 },
                "existingSecret": { "type": "string", "minLength": 1 }
              },
              "required": ["existingSecret"]
            }
          ]
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
        "containerSecurityContext": { "type": "object", "additionalProperties": true }
      }
    },
    "meilisearch": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "$ref": "#/definitions/image" },
        "masterKey": { "type": "string" },
        "existingSecret": { "type": "string" },
        "existingSecretMasterKeyKey": { "type": "string", "minLength": 1 },
        "env": {
          "type": "string",
          "enum": ["production", "development"]
        },
        "persistence": { "$ref": "#/definitions/persistence" },
        "experimentalMetrics": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resources" },
        "podSecurityContext": { "$ref": "#/definitions/podSecurityContext" },
        "containerSecurityContext": { "type": "object", "additionalProperties": true }
      },
      "oneOf": [
        {
          "description": "Inline master key path: masterKey set (16+ bytes), existingSecret empty.",
          "properties": {
            "masterKey": { "type": "string", "minLength": 16 },
            "existingSecret": { "type": "string", "maxLength": 0 }
          },
          "required": ["masterKey"]
        },
        {
          "description": "External Secret path: existingSecret set, inline masterKey empty.",
          "properties": {
            "masterKey": { "type": "string", "maxLength": 0 },
            "existingSecret": { "type": "string", "minLength": 1 }
          },
          "required": ["existingSecret"]
        }
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]
        },
        "size": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": {
          "type": "string",
          "enum": ["traefik", "gateway-api", "none"]
        },
        "className": { "type": "string" },
        "hosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "tls": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "enabled": { "type": "boolean" },
            "certManager": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "issuerRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "kind"],
                  "properties": {
                    "name": { "type": "string", "minLength": 1 },
                    "kind": {
                      "type": "string",
                      "enum": ["Issuer", "ClusterIssuer"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "networkPolicies": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelector": { "type": "object", "additionalProperties": true }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "$ref": "#/definitions/pdbBlock" },
        "queue": { "$ref": "#/definitions/pdbBlock" }
      }
    },
    "hpa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "$ref": "#/definitions/hpaBlock" },
        "queue": { "$ref": "#/definitions/hpaBlock" }
      }
    }
  }
}
